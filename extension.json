{
    "identifier": "dev.patriotever.pythondebugcurrentfile",

    "name": "Python Run, Debug & Jupyter",

    "organization": "PatriotEver Lab",

    "description": "Smart Python and Jupyter tasks for Nova: run and debug Python files, and launch JupyterLab automatically.",

    "bugs": "https://github.com/utkarsh-data-enthusiast/nova-python-debug-current-file/issues",

    "repository": "https://github.com/utkarsh-data-enthusiast/nova-python-debug-current-file",

    "license": "MIT License",

    "version": "2.0",

    "min_runtime": "9.0",

    "categories": [
        "tasks"
    ],

    "main": "main.js",

    "entitlements": {
        "process": true
    },

    "debugAdapters": {
        "debugpy": {
            "name": "Python (debugpy)"
        }
    },

    "breakpoints": [
        {
            "syntax": "python"
        }
    ],

    "taskTemplates": {
        "python": {
            "name": "Python",

            "description": "Smart Python and Jupyter task. Run executes Python or opens JupyterLab; Build debugs Python or opens JupyterLab depending on the focused file.",

            "tasks": {
                "build": {
                    "resolve": "python-smart"
                },

                "run": {
                    "resolve": "python-smart"
                }
            }
        }
    },

    "activationEvents": [
        "*"
    ]
}